# 复制为 backend/.env 后修改。已存在的系统环境变量优先于此文件。

# ---- 基础 ----
# dev | prod（prod 会强制要求密钥、禁止模拟支付、关闭接口文档）
YCG_ENV=dev
# 对外访问地址（支付返回地址会用它拼接，生产必须是 HTTPS）
YCG_BASE_URL=http://127.0.0.1:8000
# 用于签名 Cookie 与下载链接，生产请用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成
YCG_SECRET_KEY=
# 运营看板令牌（/admin 页面使用）
YCG_ADMIN_TOKEN=
# AI付官网上本作品的详情页链接（导出成功页“去点赞”用）
YCG_SHOWCASE_URL=https://aipay.alipay.com/community/events/payathon-2026

# ---- 存储与处理 ----
# YCG_DATA_DIR=./data
# YCG_DATABASE_URL=sqlite:///./data/yiciguo.db
YCG_PHOTO_TTL_HOURS=24
YCG_MAX_UPLOAD_MB=15
# 同时处理的照片数（2C4G 建议 2）
YCG_WORKERS=2
# YCG_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc

# ---- 支付 ----
# mock：本地模拟收银台（仅开发演示）；nowpay：即刻收直连；off：关闭支付
YCG_PAY_MODE=mock

# 以下仅 YCG_PAY_MODE=nowpay 时需要
# 支付宝开放平台应用 ID（必须与报名参赛、即刻收签约是同一个支付宝账号主体）
ALIPAY_APP_ID=
# 应用私钥：二选一，推荐用文件
ALIPAY_PRIVATE_KEY_FILE=
# ALIPAY_PRIVATE_KEY=
# 支付宝公钥（不是应用公钥）
ALIPAY_PUBLIC_KEY_FILE=
# ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_APP_AUTH_TOKEN=
# 即刻收管理小程序里复制的商品 ID
# 商品 A「照片导出」：次数包 QUANTITY/COUNT，档位 1次¥0.99 / 3次¥1.99 / 10次¥4.99
NOWPAY_PRODUCT_COUNT=
# 商品 B「备考季月卡」：时长包 ONE_TIME_DURATION/MONTH ¥9.9（可不配）
NOWPAY_PRODUCT_MONTHLY=
